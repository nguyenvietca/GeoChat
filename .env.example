# GeoChat server configuration
# Optional registration bot verification. Secret stays on the Backend.
REGISTRATION_BOT_CHECK_ENABLED=false
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
TURNSTILE_HOSTNAMES=
# Direct Java development trusts no proxy by default; Compose trusts only service web.
TRUSTED_PROXY_HOSTS=
# Optional Google OIDC. Credentials stay server-side. Never use VITE_ for secrets.
GOOGLE_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8081/api/login/oauth2/code/google
GOOGLE_WEB_ORIGIN=http://localhost:8081

# PostgreSQL local development
DB_HOST=localhost
DB_PORT=5432
DB_NAME=geochat
DB_USERNAME=geochat
DB_PASSWORD=geochat

# Compose-published ports and immutable application image tag
WEB_PORT=8081
APP_VERSION=local

# Replace with a unique random key of at least 32 UTF-8 bytes
JWT_SECRET=replace-with-a-unique-random-secret-at-least-32-bytes

# Comma-separated browser origins allowed by the API and WebSocket endpoint
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081,http://localhost:5173,http://127.0.0.1:5173

# Spring Boot
SERVER_PORT=8080
# Production: start with SPRING_PROFILES_ACTIVE=prod. The prod profile requires
# DB_NAME, DB_USERNAME, DB_PASSWORD, JWT_SECRET and CORS_ALLOWED_ORIGINS.
SPRING_PROFILES_ACTIVE=
RATE_LIMIT_ENABLED=true

# Expo push notifications (disabled by default)
PUSH_NOTIFICATIONS_ENABLED=false
EXPO_ACCESS_TOKEN=

# Private chat images: absolute path recommended for deployed services
GEOCHAT_IMAGE_STORAGE=./var/chat-images
GEOCHAT_MAX_IMAGE_SIZE=5242880
GEOCHAT_IMAGE_TYPES=image/jpeg,image/png,image/webp
